    "i18next-http-backend": "^4.0.0",
    "number-to-words": "^1.2.4",
    "qrcode.react": "^4.2.0",
    "react-i18next": "^17.0.6"
  },
  "devDependencies": {
    "@types/number-to-words": "^1.2.3",
    "@vitejs/plugin-react": "^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.4",
