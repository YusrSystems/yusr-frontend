{
  "name": "yusr-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Yusr ERP Desktop Client with Native WhatsApp and PDF Engine",
  "author": "Yusr Systems",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron dist/main.js",
    "build:win": "tsc && electron-builder --win nsis",
    "build:appx": "tsc && electron-builder --win appx",
    "build:all": "tsc && electron-builder --win nsis appx"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.19",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "43.0.0",
    "electron-builder": "^25.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.yusr.erp",
    "productName": "Yusr ERP",
    "electronVersion": "34.2.0",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "applicationId": "Braa.Yusr",
      "identityName": "Braa.Yusr",
      "publisher": "CN=FEA22BBC-A274-4B32-81DB-71E07765AB0B",
      "publisherDisplayName": "Braa",
      "displayName": "يسر | Yusr",
      "backgroundColor": "#2563eb",
      "showNameOnTiles": true,
      "languages": [
        "ar",
        "en"
      ]
    }
  }
}